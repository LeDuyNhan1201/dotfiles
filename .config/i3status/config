general {
  colors = true
  interval = 1
}

order += "wireless _first_"
order += "ethernet enp47s0"
order += "volume master"
order += "read_file brightness"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
  format_up = "W: %essid%quality %ip"
  format_down = "W: down"
}

ethernet enp47s0 {
    format_up = "|ETH: %ip"
    format_down = "|ETH: down"
}

volume master {
  format = "|Vol: %volume"
  format_muted = "|♪: muted (%volume)"
  device = "default"
  mixer = "Master"
  mixer_idx = 0
}

battery all {
  format = "|Bat: %percentage %remaining"
}

disk "/" {
  format = "|Disk: %used/%total"
}

load {
  format = "|CPU: %1min"
}

memory {
  format = "|Mem: %used/%total"
}

tztime local {
  format = "|%A, %B %d, %Y %H:%M:%S"
}

read_file brightness {
  path = "/sys/class/backlight/intel_backlight/actual_brightness"
  format = "|Bri: %content"
}
